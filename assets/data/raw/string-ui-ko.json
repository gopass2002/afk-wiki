    {
      "id": 119,
      "key": "NpcTalk_WhasanJangro_1",
      "value": "허어…"
    },
    {
      "id": 120,
      "key": "NpcTalk_WhasanJangro_2",
      "value": "수상한 기운이야."
    },
    {
      "id": 121,
      "key": "NpcTalk_WhasanJangro_3",
      "value": "매화는 이르게 핀다."
    },
    {
      "id": 122,
      "key": "NpcTalk_WhasanJangro_4",
      "value": "화산의 이름으로."
    },
    {
      "id": 123,
      "key": "NpcTalk_WhasanJangro_5",
      "value": "요즘 산이 소란하군."
    },
    {
      "id": 124,
      "key": "NpcTalk_WhasanJangro_6",
      "value": "정진하게."
    },
    {
      "id": 125,
      "key": "NpcTalk_Swordsaint_1",
      "value": "검은 곧 마음이다."
    },
    {
      "id": 126,
      "key": "NpcTalk_Swordsaint_2",
      "value": "베는 것만이 검이 아니다."
    },
    {
      "id": 127,
      "key": "NpcTalk_Swordsaint_3",
      "value": "…아직 멀었군."
    },
    {
      "id": 128,
      "key": "NpcTalk_Swordsaint_4",
      "value": "바람을 읽어라."
    },
    {
      "id": 129,
      "key": "NpcTalk_Swordsaint_5",
      "value": "한 수 배우고 싶은가."
    },
    {
      "id": 130,
      "key": "NpcTalk_Yujung_1",
      "value": "…재미있는 산이야."
    },
    {
      "id": 131,
      "key": "NpcTalk_Yujung_2",
      "value": "그 검격, 기억해두지."
    },
    {
      "id": 132,
      "key": "NpcTalk_Yujung_3",
      "value": "바람이 수상해."
    },
    {
      "id": 133,
      "key": "NpcTalk_Yujung_4",
      "value": "매화 아래가 좋군."
    },
    {
      "id": 134,
      "key": "NpcTalk_Yujung_5",
      "value": "…누굴 기다리는 건 아니야."
    },
    {
      "id": 135,
      "key": "NpcTalk_Dokgocheol_1",
      "value": "흑풍채가 이 산의 주인이다!"
    },
    {
      "id": 136,
      "key": "NpcTalk_Dokgocheol_2",
      "value": "겁먹지 마라!"
    },
    {
      "id": 137,
      "key": "NpcTalk_Dokgocheol_3",
      "value": "만만한 놈들만 골라라."
    },
    {
      "id": 138,
      "key": "NpcTalk_Dokgocheol_4",
      "value": "이 산은 내 구역이다."
    },
    {
      "id": 139,
      "key": "NpcTalk_Dokgocheol_5",
      "value": "…배짱 좋은 놈이군."
    },
