    {
      "id": 203,
      "key": "NpcTalk_Chaehee_1",
      "value": "어머, 그 차림은 좀 아니죠."
    },
    {
      "id": 204,
      "key": "NpcTalk_Chaehee_2",
      "value": "이리 와요. 제가 바꿔드릴게요."
    },
    {
      "id": 205,
      "key": "NpcTalk_Chaehee_3",
      "value": "제 옷 입고 못생기긴 어려워요."
    },
    {
      "id": 206,
      "key": "NpcTalk_Chaehee_4",
      "value": "여인 옷을 입으면 몸도 여인이 돼요."
    },
    {
      "id": 207,
      "key": "NpcTalk_Chaehee_5",
      "value": "치수 걱정은 촌스러워요."
    },
    {
      "id": 208,
      "key": "NpcTalk_Chaehee_6",
      "value": "만지셨으면 사셔야죠?"
    },
    {
      "id": 209,
      "key": "NpcTalk_Chaehee_7",
      "value": "채화는 얼굴, 저는 전부."
    },
    {
      "id": 210,
      "key": "NpcTalk_Chaehee_8",
      "value": "어울리네요. 제 옷이니까."
    },
    {
      "id": 211,
      "key": "NpcTalk_Chaewha_1",
      "value": "부적 한 장, 인생 한 번."
    },
    {
      "id": 212,
      "key": "NpcTalk_Chaewha_2",
      "value": "그 얼굴, 제가 바꿔드릴까요?"
    },
    {
      "id": 213,
      "key": "NpcTalk_Chaewha_3",
      "value": "뭐가 나올진 저도 몰라요. 그게 재미죠."
    },
    {
      "id": 214,
      "key": "NpcTalk_Chaewha_4",
      "value": "어머, 그 머리 제 작품이네. 역시."
    },
    {
      "id": 215,
      "key": "NpcTalk_Chaewha_5",
      "value": "딱 한 장만 더. 다들 그러던데요?"
    },
    {
      "id": 216,
      "key": "NpcTalk_Chaewha_6",
      "value": "수염이 나와도 환불은 안 돼요."
    },
    {
      "id": 217,
      "key": "NpcTalk_Chaewha_7",
      "value": "원판 탓은 하지 마시고요."
    },
    {
      "id": 218,
      "key": "NpcTalk_Chaewha_8",
      "value": "채희는 옷, 저는 얼굴."
    },
    {
      "id": 219,
      "key": "NpcTalk_Munpa_1",
      "value": "쿨... 쿨... 헉, 어서 오세요!"
    },
    {
      "id": 220,
      "key": "NpcTalk_Munpa_2",
      "value": "안 잤습니다. 눈만 감았죠."
    },
    {
      "id": 221,
      "key": "NpcTalk_Munpa_3",
      "value": "개파 서류가... 분명 여기..."
    },
    {
      "id": 222,
      "key": "NpcTalk_Munpa_4",
      "value": "혼자 다니지 마시고... 문파 드세요."
    },
    {
      "id": 223,
      "key": "NpcTalk_Munpa_5",
      "value": "하암... 오늘 며칠이죠?"
    },
    {
      "id": 224,
      "key": "NpcTalk_Munpa_6",
      "value": "아이고 깜짝이야! 언제 오셨어요."
    },
